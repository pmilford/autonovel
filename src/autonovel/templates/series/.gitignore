# autonovel runtime state
.autonovel/in-progress.lock
.autonovel/checkpoints/
.autonovel/last-action.json
# .autonovel/command-log.jsonl is append-only history; commit it
# unless you'd rather keep your trail private.

# Python tooling
*.pyc
__pycache__/
.env
.venv/

# Typeset artefacts — most regenerable from chapter prose
# (run /autonovel:typeset to rebuild). The timestamped builds
# (`<book>_YYYYMMDD_HHMM.pdf`) are excluded — committing one per
# rebuild would balloon the repo. The convenience pointer
# (`<book>_latest.pdf` / `_latest.epub`) IS kept: always the most
# recent successful build, so a fresh `git clone` of your backup
# carries a usable PDF and ePub immediately. If you'd rather not
# commit any binary outputs at all, delete the two `!` lines below.
books/*/typeset/*.pdf
!books/*/typeset/*_latest.pdf
books/*/typeset/*.epub
!books/*/typeset/*_latest.epub
books/*/typeset/novel.tex
books/*/typeset/chapters_content.tex
books/*/typeset/chapters_combined.md
books/*/typeset/front_matter.tex
books/*/typeset/metadata.yaml
# LaTeX intermediates (when tectonic leaves any behind)
books/*/typeset/*.aux
books/*/typeset/*.log
books/*/typeset/*.out
books/*/typeset/*.toc

# Audiobook output — large MP3 / WAV / M4B files. Scripts and
# voices.yaml ARE committed; audio files are regenerable via
# /autonovel:audiobook-generate.
books/*/audiobook/*.mp3
books/*/audiobook/*.wav
books/*/audiobook/*.m4b
books/*/audiobook/chunks/

# Generated art derivatives — rasterised PNGs, vectorised SVGs.
# The source `cover.png` and `ornament_chNN.png` ARE committed
# (regenerating them costs API credit). The derivatives below are
# rebuilt by /autonovel:art-vectorize / /autonovel:cover-print.
books/*/art/svg/cache/
books/*/art/pdf/

# Landing-page output (regenerated via /autonovel:landing).
books/*/landing/dist/

# Version diffs (regenerated from git / checkpoints by /autonovel:diff;
# ~1 MB each). The `.why.json` annotations are LLM output and the
# `last_read.json` bookmark is yours, so both stay tracked.
books/*/edit_logs/diff_*.html
books/*/edit_logs/diff_*.json
!books/*/edit_logs/diff_*.why.json

# Film renders (/autonovel:storyboard, /autonovel:table-read, /autonovel:animatic).
# Every take, the frames sampled for the viewer check, the cut films and the
# recorded lines are rebuilt from their manifests. The selected keyframes and
# sound cues, the character sheets and the designed voice references ARE
# committed: a model asked again does not draw the same frame or voice.
books/*/film/**/takes/
books/*/film/animatic/*.mp4
books/*/film/animatic/*_frames/
books/*/film/audio/table_read/*.wav
# Moving takes (shot_render): the takes and their smoothed, upscaled copies are
# rebuilt from film/render/<scene>.json (prompt, seed, keyframe); the picks and
# the manifests are committed. Cut films are rebuilt from the picks.
books/*/film/render/*/finished/
books/*/film/render/*.log
books/*/film/cut/*.mp4

# 3D sets and layouts (docs/film-3d-plan.md): the .blend files, Blockout's
# shot handoffs and every guide frame are rebuilt from film/sets/<location>.py
# and film/blocking/<location>/staging.json; the set's approval previews, the
# staging, Blockout's project.json and the keyframes are committed. Moving
# takes from the 3D layouts, like the 2D ones, are rebuilt from their records.
books/*/film/sets/*.blend
books/*/film/sets/*.blend1
books/*/film/blocking/*/*.blockout/exports/
books/*/film/layout/
books/*/film/render3d/**/inputs/
books/*/film/render3d/**/*.mp4

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
*~
